#: radeontop.c:93
#, c-format
msgid ""
"\n"
"\tRadeonTop for R600 and later, plus R300-class integrated RS4xx GPUs.\n"
"\n"
"\tUsage: %s [-cThmv] [--dither-seed seed] [-b bus] [-d file] [-i seconds] [-"
"l limit] [-p device] [-t ticks]\n"
"\n"
"-b --bus 3\t\tPick card from the selected PCI bus (hexadecimal)\n"
"-c --color\t\tEnable colors\n"
"-d --dump file\t\tDump data to the named file, - for stdout\n"
"-i --dump-interval 1\tNumber of seconds between dumps (default %u)\n"
"-l --limit 3\t\tQuit after dumping N lines, default forever\n"
"-m --mem\t\tForce the validated PCI sysfs resourceN MMIO path\n"
"-p --path device\tOpen DRM device node by path\n"
"-t --ticks 50\t\tSamples per second (default %u)\n"
"-T --transparency\tEnable transparency\n"
"   --dither-seed 7\tOffset each sample inside its own slot, seeded by N,\n"
"\t\t\tso a workload periodic at a harmonic of the sample\n"
"\t\t\trate meets a moving phase.  Omit for the exact grid.\n"
"\n"
"-h --help\t\tShow usage help\n"
"-v --version\t\tShow the version\n"
msgstr ""

